# Django Settings
DJANGO_SECRET_KEY=change-in-production-use-a-strong-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration (Defaults to SQLite; use postgres://user:pass@host:5432/dbname for PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3

# Default OCR Engine: easyocr, trocr, or google_vision
OCR_ENGINE=easyocr

# TrOCR Model Identifier (e.g. microsoft/trocr-small-handwritten or microsoft/trocr-base-handwritten)
TROCR_MODEL_ID=microsoft/trocr-small-handwritten

# Google Cloud Vision & Translation (Optional - leave blank to use local offline OCR and fallback)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_API_KEY=

# Translation Engine
TRANSLATION_PROVIDER=google

# File upload limits
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=15
